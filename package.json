{
  "name": "open-mode-control",
  "version": "1.0.1",
  "description": "Obsidian plugin: open existing notes in reading view and new notes in editing view.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node esbuild.config.mjs test",
    "test:flow": "node tests/run-plugin-test.mjs",
    "lint": "eslint .",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "obsidian": "latest",
    "tslib": "^2.6.3",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.0"
  }
}
